# Telegram API 配置
# API_ID 和 API_HASH 可在 https://my.telegram.org/apps 获取
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash

# Telegram 机器人 Token，可从 @BotFather 获取
BOT_TOKEN=your_telegram_bot_token

# Pyrogram 本地会话名称
SESSION_NAME=my_bot

# 访问白名单
# 多个 ID 使用英文逗号分隔，不需要空格。
USER_WHITELIST=123456789,987654321
GROUP_WHITELIST=-1001234567890

# 本地下载目录
# Bot 会先把 Telegram 视频下载到此目录，再按配置决定是否复制到 Alist。
FIXED_DOWNLOAD_DIR=/storage/alistdata/telegram

# Alist 上传配置
# 设置为 false 时，文件只保留在本地下载目录，不复制到 Alist。
UPLOAD_TO_ALIST=true
BASE_URL=https://your-alist.example.com
ALIST_USERNAME=your_alist_username
ALIST_PASSWORD=your_alist_password

# Alist 复制路径
# SRC_DIR 是 Alist 中映射到 FIXED_DOWNLOAD_DIR 的路径。
# DST_DIR 是 Alist 中目标网盘目录路径。
SRC_DIR=/local/telegram
DST_DIR=/115/TG_Downloader

# 视频预览图配置
# GENERATE_GRID 控制是否生成 3x3 九宫格预览图。
GENERATE_GRID=true

# 下载并发数
# 建议保守设置，避免 Telegram、磁盘或 ffmpeg 负载过高。
MAX_CONCURRENT_DOWNLOADS=2
